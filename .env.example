# Artifact Service 本地开发配置样例（全部为本地 dev 值，禁止用于任何真实环境）
# 用法：cp .env.example .env && 按需调整

# HTTP 监听地址
ARTIFACT_API_BIND=127.0.0.1:8110
# 日志级别（tracing env-filter 语法）
ARTIFACT_API_LOG=info
# 数据库连接（本地专用 dev 容器；务必 127.0.0.1，不要用 localhost）
ARTIFACT_API_DATABASE_URL=postgres://postgres:artifact_dev@127.0.0.1:16500/artifact_service
# 数据库连接池上限
ARTIFACT_API_DB_MAX_CONNECTIONS=8
# 业务请求超时（秒）
ARTIFACT_API_REQUEST_TIMEOUT_SECS=10

# ── 独立 Worker（ART-03B-01：仅协调维护，无 SeeCode/Node，不领取 Job） ──────
# 独立 DB 账号（与 API 账号分离；deploy/db-roles.sql 的 __WORKER_ROLE__）
ARTIFACT_WORKER_DATABASE_URL=postgres://artifact_worker:worker_dev@127.0.0.1:16500/artifact_service
# Worker 实例标识（1..=128 字符，不含主机敏感信息）
ARTIFACT_WORKER_ID=artifact-worker-1
# 协调维护（租约恢复 + 输入清理）的间隔（毫秒，>= 1000）
ARTIFACT_WORKER_MAINTENANCE_INTERVAL_MS=10000
# 日志级别
ARTIFACT_WORKER_LOG=info
# DB 连接池上限
ARTIFACT_WORKER_DB_MAX_CONNECTIONS=4

# 说明：
# - Worker 的配置取值不合法时直接启动失败，不会静默回落默认值。
# - 独立 dev 容器每次迁移之后都要重新应用角色授权（迁移重建函数会丢失其 EXECUTE 授权）：
#     sed -e 's/__MIGRATOR_ROLE__/postgres/' -e 's/__APP_ROLE__/artifact_app/' \
#         -e 's/__WORKER_ROLE__/artifact_worker/' deploy/db-roles.sql \
#       | docker exec -i -e PGPASSWORD=artifact_dev artifact-dev-pg \
#           psql -U postgres -d artifact_service -v ON_ERROR_STOP=1
#   然后按需 ALTER ROLE 设置本地口令。

# ── 受信委托签发方（WP-LMMS-DELEGATION-01 契约 v0.2 §4，候选 B） ────────────
# JSON 数组：[{ "issuer": "ai-pm", "jwks_url": "https://.../jwks.json", "audience": "artifact-service" }]
# audience 缺省即 artifact-service；jwks_url 必须 https（仅 127.0.0.1/localhost/[::1]
# 允许 http 回环，供本机 compose 联调）。
# **缺省（未设置）= 空清单 = 维持全拒**：ClosedDelegationVerifier，一切业务请求 401。
# issuer 配置非空时装配 AiPmDelegationVerifier（RS256 + kid-strict JWKS 缓存）。
#ARTIFACT_API_DELEGATION_ISSUERS=[]

# 说明：
# - 未配置受信签发方时运行时身份验证使用 ClosedDelegationVerifier（fail-closed，
#   一切业务请求 401/403）。LMMS token-service 的两个 P0（resource token 无鉴权
#   挂载、claims 缺 aud/tid）是 LMMS 后续版本需求；候选 B（AI-PM 签发）不依赖它，
#   见 docs/architecture/WP-LMMS-DELEGATION-01-AUTHORIZATION-CONTRACT.md。
# - 不存在任何运行时"开发绕过"开关；测试替身仅通过 cargo feature `test-doubles` 编译期启用，
#   且只被 tests/ 集成测试使用，发布二进制不包含该代码路径。
